# ---------------------------------------------------------------
# fluxmedia-site: Next.js static export + PHP endpoints (/api)
# Tracked: src/, public/, api/ (incl. PHPMailer), deploy/, .env.example
# ---------------------------------------------------------------

# Static export output (next build with output: 'export')
/out/
# Release folders created by the deploy script (rsync + `current` symlink)
/releases/
/current

# Next.js build cache / types
/.next/
next-env.d.ts
*.tsbuildinfo

# Dependencies
node_modules/
.pnpm-store/

# Generated at build time (sitemap.xml / robots.txt come from sources in public/ or src/)
/public/sitemap*.xml
/public/robots.txt
# Build-script image output (AVIF/WebP generated from originals)
/public/img/generated/

# ---------------------------------------------------------------
# Secrets and server-side PHP runtime data
# Real config lives on the server outside the webroot; never commit it.
# ---------------------------------------------------------------
.env
.env.*
!.env.example

/api/config.php
/api/config.local.php
/api/config/*
!/api/config/*.example.php
/api/.env
/api/logs/
/api/storage/
/api/rate-limit/
/api/*.log
/api/vendor/composer/tmp-*
*.log

# Deploy credentials / server details
/deploy/*.local
/deploy/.env
/deploy/secrets*
*.pem
*.key

# ---------------------------------------------------------------
# Documentation is not part of the repo/export
# (strategy and competitor docs stay in the archive repo)
# ---------------------------------------------------------------
/docs/


# ---------------------------------------------------------------
# Tooling / OS / editor
# ---------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vercel/
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.claude/settings.local.json
